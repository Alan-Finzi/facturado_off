# Este archivo debe copiarse a local.properties y ajustarse según tu entorno
# Ruta al SDK de Flutter
flutter.sdk=C:\\src\\flutter

# Propiedades del proyecto
flutter.buildMode=debug
flutter.versionName=1.0.4
flutter.versionCode=1

# Configuración de NDK (IMPORTANTE)
